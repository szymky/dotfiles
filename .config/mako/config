# ── Default notifications ─────────────────────────────────────────────────────

font=JetBrainsMono Nerd Font 11

background-color=#1e1e2ecc
text-color=#cdd6f4
border-color=#cba6f7aa
progress-color=over #313244

border-size=1
border-radius=12

width=360
height=120
margin=12
padding=16

anchor=top-right

icons=1
icon-location=left
icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=48

max-visible=5
sort=-time

default-timeout=6000
ignore-timeout=0

layer=overlay

[urgency=low]
background-color=#1e1e2ecc
text-color=#a6adc8
border-color=#45475aaa
default-timeout=4000

[urgency=normal]
background-color=#1e1e2ecc
text-color=#cdd6f4
border-color=#cba6f7aa
default-timeout=6000

[urgency=high]
background-color=#1e1e2ecc
text-color=#f38ba8
border-color=#f38ba8cc
default-timeout=0

# ── App-specific overrides ────────────────────────────────────────────────────

[app-name=Spotify]
border-color=#a6e3a1aa
default-timeout=3000

[app-name=discord]
border-color=#89b4faaa

[category=network]
border-color=#89b4faaa

[category=battery]
border-color=#f9e2afaa
